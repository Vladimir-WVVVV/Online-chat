# OnlineChat example environment. Copy to .env for deployment.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=onlinechat
MYSQL_USER=onlinechat
MYSQL_PASSWORD=change_me_app
REDIS_PASSWORD=
JWT_SECRET=change-this-development-secret-to-at-least-32-characters
JWT_EXPIRE_MINUTES=1440
DEMO_SEED_USERS=false
BACKEND_PORT=8080
FRONTEND_API_BASE_URL=http://localhost:8080/api
FRONTEND_WS_URL=http://localhost:8080/ws
# Maven does not load this file automatically. Use backend/run-ai-local.sh or export/source it first.
# This example enables the real HTTP provider; application.yml still defaults to mock when unset.
AI_PROVIDER=http
AI_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_API_KEY=
AI_MODEL=glm-4.5-flash
